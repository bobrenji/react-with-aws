#!/usr/bin/env bash
# Lint + format the staged files of every changed module, auto-fix, and re-stage.
# Aborts the commit if ESLint finds problems it cannot auto-fix.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Staged, non-deleted files (null-delimited; bash 3.2 safe).
staged=()
while IFS= read -r -d '' f; do
  staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z)
[ ${#staged[@]} -eq 0 ] && exit 0

fail=0
touched=()
for f in "${staged[@]}"; do
  case "$f" in
    packages/*) ;;
    *) continue ;;
  esac
  scripts/format-file.sh "$f" || fail=1
  touched+=("$f")
done

# Re-stage any auto-fixes applied to the originally staged files.
[ ${#touched[@]} -gt 0 ] && git add -- "${touched[@]}"

if [ "$fail" -ne 0 ]; then
  echo "✖ ESLint found problems it could not auto-fix — commit aborted." >&2
  exit 1
fi
exit 0
